# Telegram Bot API Tokens
IMAGE_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz_image
IMAGE_BOT_1_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz_image
ADMIN_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz_admin
ADMIN_USER_IDS_RAW=123456789,987654321

# AI Generation Engine API Keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Supabase Database Credentials
# For Cloud Supabase:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-service-role-or-anon-key
#
# For Self-Hosted Supabase (via Docker / Kong API Gateway on Port 8001):
# SUPABASE_URL=http://localhost:8001
# SUPABASE_KEY=your-self-hosted-service-role-or-anon-key

# Self-Hosted PostgreSQL Credentials (Optional / Direct Connection Reference)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@localhost:5432/postgres

# Monetization Settings
FREE_DAILY_CREDITS=3
DEFAULT_GENERATION_COST_CREDITS=1

# Platform Settings
BOT_STRATEGY=polling # polling or webhook
USE_MOCK_GENERATOR=false
METRICS_ENABLED=true

# Dokploy & Traefik Routing
DOKPLOY_HOST=bots.yourdomain.com

# -----------------------------------------------------------------------------
# 🔒 Reserved Platform Port Mapping Reference (Do Not Collide):
# -----------------------------------------------------------------------------
#  Port  80   : Traefik HTTP (Dokploy / Webhook Ingress)
#  Port  443  : Traefik HTTPS (Let's Encrypt TLS)
#  Port  3000 : Dokploy Dashboard UI (or Grafana Dashboard UI)
#  Port  3100 : Loki Log Aggregator
#  Port  5432 : PostgreSQL / Supabase DB
#  Port  6379 : Redis 7 Datastore & Queue
#  Port  8000 : FastAPI Webhook Server & Prometheus /metrics Gateway
#  Port  8001 : Supabase PostgREST Gateway
#  Port  8080 : Supabase Meta Internal API
#  Port  8082 : Supabase Studio Dashboard UI
#  Port  9090 : Prometheus Time-Series Scraper UI
# -----------------------------------------------------------------------------
